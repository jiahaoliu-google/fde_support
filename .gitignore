# Python Virtual Environment
.venv/
venv/
env/

# Python Bytecode & Cache
__pycache__/
*.pyc
*.pyo

# Terraform Local Cache & Binaries
.terraform/
*.tfstate
*.tfstate.backup

# Local Databases & Binaries
*.db
local_dev.db
cloud-sql-proxy

# OS Junk
.DS_Store
Thumbs.db

# Archive & Temp
archive/

# Local tool state, logs & backups (never commit)
*.log
*.bak
.google-agents-cli/
.adk/

# Python packaging build output
*.egg-info/

# Generated eval / grading outputs (reproducible)
artifacts/

# Coverage output (pytest --cov)
.coverage
.coverage.*
coverage.xml
htmlcov/

# deploy.sh --build-only output
**/.last_image

# agents-cli deploy output: per-deploy, per-project state (engine ID, timestamps,
# operation IDs). Deploys find the engine by display name; Agent Runtime injects
# GOOGLE_CLOUD_AGENT_ENGINE_ID at runtime. Regenerated locally on every deploy.
agents/*/deployment_metadata.json
